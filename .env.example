# Copy to .env locally. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-secret-at-least-32-random-characters>
PORT=3000
# Comma-separated exact frontend origins, e.g. http://localhost:5173,https://app.example.com
FRONTEND_ORIGINS=http://localhost:5173
